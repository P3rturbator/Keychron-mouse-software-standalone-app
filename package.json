{
  "name": "keychron-mouse-config",
  "version": "1.0.0",
  "description": "Offline Windows 11 Keychron Mouse Configuration Tool",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win"
  },
  "dependencies": {
    "electron-store": "^6.0.1",
    "node-hid": "^3.1.0"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.keychron.mouseconfig",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
